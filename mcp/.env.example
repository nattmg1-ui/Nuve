# mcp/.env.example
# Copia este archivo a "mcp/.env" y pon una cuenta de la tienda.
# El .env NUNCA se sube a GitHub. Aquí solo van ejemplos.

# API GraphQL del backend (local)
NUVE_GRAPHQL_URL=http://localhost:4000/graphql

# Dirección de la tienda (solo para armar los enlaces "Ver en la tienda")
NUVE_TIENDA_URL=http://localhost:5173

# Cuenta con la que Claude entra a la tienda. El rol de esta cuenta decide
# qué puede hacer: ADMIN (todo), OPERADOR (pedidos e inventario) o CLIENTE
# (catálogo y sus propios pedidos). Si lo dejas vacío, solo funciona el catálogo.
NUVE_CORREO=
NUVE_PASSWORD=
