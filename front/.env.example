# URL del backend GraphQL (solo la usa el servidor de Astro, nunca el navegador)
GRAPHQL_URL=http://localhost:4000/

# Llave PUBLICA de Mercado Pago (Tus integraciones > tu app > Credenciales de prueba > Public Key).
# No es secreta: solo sirve para mostrar el formulario de tarjeta.
PUBLIC_MP_PUBLIC_KEY=APP_USR-453fa7e9-154f-4d6e-8582-8911b7d0f9d4
# ---------------- Cloudflare Turnstile (anti-bots en inicio de sesión y registro) ----------------
# Llaves de PRUEBA de Cloudflare (siempre aprueban, sirven en local sin crear cuenta).
# Para publicar: dash.cloudflare.com > Turnstile > Add widget, y pon tus llaves reales.
# Si las dejas vacías, el login y el registro funcionan sin verificación.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
