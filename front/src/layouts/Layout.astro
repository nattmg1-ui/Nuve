---
import '../styles/tokens.css';
import '../components/TopBar.css';
import '../components/Footer.css';
import '../styles/responsive.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import AsistenteRecomendaciones from '../components/AsistenteRecomendaciones';

interface Props {
  titulo?: string;
  /** Muestra el botón "Pide una recomendación" (Asesora Nuvé, API de Gemini). */
  asistente?: boolean;
}
const { titulo = 'Nuvé — Belleza que te ilumina', asistente = false } = Astro.props;
const usuario = Astro.locals.usuario;

// Tema visual elegido en "Mi perfil". Con "Sistema" (o sin sesión) no se pone
// nada y manda el modo claro/oscuro del dispositivo (ver styles/theme.css).
const tema = Astro.locals.usuario?.tema;
const dataTema = tema === 'CLARO' ? 'claro' : tema === 'OSCURO' ? 'oscuro' : undefined;
---

<!doctype html>
<html lang="es" data-tema={dataTema}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
  </head>
  <body>
    <TopBar />
    <div class="container" style="padding-block: 32px;">
      <slot />
    </div>
    <Footer />
    {
      asistente && (
        <AsistenteRecomendaciones client:idle conSesion={Boolean(usuario)} nombre={usuario?.nombre.split(' ')[0] ?? null} />
      )
    }
  </body>
</html>