---
import Layout from '../layouts/Layout.astro';
import '../components/Main.css';
import '../components/Home.css';
import Hero from '../components/Hero.astro';
import ContextBanner from '../components/ContextBanner.astro';
import Catalogo from '../components/Catalogo';
import { gql } from '../lib/graphql';
import { CAMPOS_TARJETA, type ProductoCatalogo } from '../lib/types';

const QUERY = `
  query Inicio {
    categorias { id nombre activo }
    productos { ${CAMPOS_TARJETA} }
  }`;

let datos: { categorias: { id: string; nombre: string; activo: boolean }[]; productos: ProductoCatalogo[] } | null = null;
let error: string | null = null;
try {
  datos = await gql(QUERY);
} catch (e) {
  error = e instanceof Error ? e.message : 'Error desconocido';
}

const busqueda = Astro.url.searchParams.get('q') ?? '';
const categoriaInicial = Astro.url.searchParams.get('categoria');
// En la tienda solo se ven las categorías activas (se administran en Admin > Categorías y marcas)
const categorias = (datos?.categorias ?? []).filter((c) => c.activo);
---

<Layout asistente>
  {
    error || !datos ? (
      <div class="main-error" role="alert">
        <p>No pudimos cargar el catálogo. {error}</p>
      </div>
    ) : (
      <Catalogo client:load categorias={categorias} productos={datos.productos} busqueda={busqueda} categoriaInicial={categoriaInicial}>
        <Hero slot="hero" />
        <ContextBanner slot="contexto" />
      </Catalogo>
    )
  }
</Layout>
