---
// Resumen del panel. En el siguiente paso se agregan las tarjetas de
// indicadores y el filtro Día / Semana / Mes.
import AdminLayout from '../../layouts/AdminLayout.astro';
import VentasChart from '../../components/VentasChart';
import { gql } from '../../lib/graphql';

let pedidos: { fecha: string; total: number; estado: string }[] = [];
let error: string | null = null;
try {
  pedidos = (
    await gql<{ pedidos: typeof pedidos }>(`query { pedidos { fecha total estado } }`, {}, Astro.locals.accessToken)
  ).pedidos;
} catch (e) {
  error = e instanceof Error ? e.message : 'Error desconocido';
}
---

<AdminLayout titulo="Resumen" descripcion="Ventas de la tienda.">
  {error && <div class="aviso aviso--error" role="alert">{error}</div>}
  <VentasChart client:load pedidos={pedidos} />
</AdminLayout>