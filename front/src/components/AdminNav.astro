---
// Menú de secciones del panel de administración.
const SECCIONES = [
  { href: '/admin', texto: 'Resumen' },
  { href: '/admin/productos', texto: 'Productos' },
  { href: '/admin/pedidos', texto: 'Pedidos' },
  { href: '/admin/usuarios', texto: 'Usuarios' },
];

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const estaActiva = (href: string) =>
  href === '/admin' ? ruta === '/admin' : ruta === href || ruta.startsWith(href + '/');
---

<nav class="admin-nav" aria-label="Secciones de administración">
  {
    SECCIONES.map((s) => (
      <a
        href={s.href}
        class:list={['admin-nav__link', { 'is-active': estaActiva(s.href) }]}
        aria-current={estaActiva(s.href) ? 'page' : undefined}
      >
        {s.texto}
      </a>
    ))
  }
</nav>