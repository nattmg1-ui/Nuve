---
// Menú de "Mi cuenta": Mis pedidos y Mi perfil.
// Usa el mismo estilo de pestañas que el panel de administración (Admin.css).
import './Admin.css';

const SECCIONES = [
  { href: '/mi-cuenta', texto: 'Mis pedidos' },
  { href: '/mi-cuenta/perfil', texto: 'Mi perfil' },
];

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const estaActiva = (href: string) => ruta === href;
---

<nav class="admin-nav" aria-label="Secciones de mi cuenta">
  {
    SECCIONES.map((s) => (
      <a
        href={s.href}
        class:list={['admin-nav__link', { 'is-active': estaActiva(s.href) }]}
        aria-current={estaActiva(s.href) ? 'page' : undefined}
      >
        {s.texto}
      </a>
    ))
  }
</nav>