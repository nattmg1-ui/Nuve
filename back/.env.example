# Copia este archivo a ".env" y ajusta los datos.

# Conexión a PostgreSQL: postgresql://usuario:password@host:puerto/nombre_de_base
DATABASE_URL=postgresql://postgres:21317222831@localhost:5432/nuve_ecommerce_1

# Pon esto en "true" solo si tu proveedor de PostgreSQL exige SSL.
PGSSL=false

# Clave secreta con la que se firman los JWT. Cámbiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Vida del access token (ej. 15m) y del refresh token (en días)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
