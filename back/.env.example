
# Copia este archivo a ".env" y ajusta los datos.
# El .env NUNCA se sube a GitHub (está en .gitignore). Este .env.example sí,
# por eso aquí solo van ejemplos, nunca contraseñas ni llaves reales.

# Conexión a PostgreSQL: postgresql://usuario:password@host:puerto/nombre_de_base
DATABASE_URL=postgresql://postgres:21317222831@localhost:5432/nuve_ecommerce_1

# Pon esto en "true" solo si tu proveedor de PostgreSQL exige SSL.
PGSSL=false

# Clave secreta con la que se firman los JWT. Cámbiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Vida del access token (ej. 15m) y del refresh token (en días)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# ---------------- Pagos (modo prueba) ----------------
# A dónde regresa el cliente después de pagar.
# Local: http://localhost:5173   ·   Render: https://nuve1.netlify.app
FRONT_URL=http://localhost:5173

# Mercado Pago: Tus integraciones > tu aplicación > Credenciales de prueba > Access Token
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx

# PayPal: developer.paypal.com > Apps & Credentials (Sandbox) > tu app
PAYPAL_CLIENT_ID=xxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxx
# Sandbox mientras se prueba (en producción: https://api-m.paypal.com)
PAYPAL_API=https://api-m.sandbox.paypal.com